# StudyMaster 后端服务环境配置

# 服务端口
PORT=3000

# JWT 身份认证密钥 (可任意修改为复杂字符串)
JWT_SECRET=studymaster_jwt_secret_key_2026_x89f

# 微信小程序配置 (请前往 微信公众平台 -> 开发管理 -> 开发设置 获取)
# 若留空，则开启本地开发调试 Mock 模式 (支持直接登录调试)
WX_APPID=wx42669d80db35383f
WX_APPSECRET=

# 开屏公告后台口令 (访问 /announcement.html 修改公告内容时填写)
# 强烈建议改成自己的复杂字符串
ADMIN_TOKEN=studymaster_admin_2026

# 公告配图的对外访问前缀，留空则按请求域名自动拼接
PUBLIC_BASE_URL=

# ── 上课提醒（微信订阅消息） ──────────────────────────────────────
# 订阅消息模板 ID。留空也行，改到 /reminder.html 后台里填（后台配置优先）
WX_REMINDER_TEMPLATE_ID=
# 按时区计算「今天第几节课」，480 = UTC+8 北京时间。容器 TZ 是 UTC 时必须保持 480
TZ_OFFSET_MINUTES=480
# 容器内是否跑定时扫描。0 = 关闭，改用外部定时任务请求 /api/reminder/cron
ENABLE_REMINDER_SCHEDULER=1
# 测试用：把微信接口指向本机 mock 服务
# WX_API_BASE=https://api.weixin.qq.com
